[Global]
IconName=mail-unread
Name=KyPost
Comment=KyPost notifications

[Event/newMail]
Name=New Mail
Comment=A new email has arrived
Icon=mail-unread
Action=Popup
ShowPopupsInDndMode=true

[Event/signInRequest]
Name=Sign-in request
Comment=A sign-in to your account is waiting for approval
Icon=dialog-password
Action=Popup
ShowPopupsInDndMode=true
